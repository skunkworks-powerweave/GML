# GML LMS — example environment variables.
# Copy to .env (NOT committed) and fill in real values before `docker compose up`.
# See README-IT.md for what each variable does.

# ── Deployment ─────────────────────────────────────────────────────────────────
DOMAIN=lms.example.org                      # your domain (Caddy will request TLS)
NODE_ENV=production

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gml_lms
POSTGRES_USER=gml
POSTGRES_PASSWORD=__change_me__

# ── Auth.js (Auth v5) ──────────────────────────────────────────────────────────
AUTH_SECRET=__generate_with_openssl_rand_-base64_32__
AUTH_URL=https://lms.example.org

# ── MinIO (S3-compatible object storage) ───────────────────────────────────────
MINIO_ROOT_USER=gml-admin
MINIO_ROOT_PASSWORD=__change_me__
MINIO_BUCKET=gml-media
MINIO_ENDPOINT=http://minio:9000

# ── Redis (BullMQ + rate limits) ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── WhatsApp Business Cloud API ────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=__generate_long_random_string__
WHATSAPP_PHONE_NUMBER_ID=__from_meta_business_manager__
WHATSAPP_ACCESS_TOKEN=__from_meta_business_manager__

# ── SMTP (for Auth.js magic links + notifications) ─────────────────────────────
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=lms@example.org
SMTP_PASS=__change_me__
SMTP_FROM="GML LMS <lms@example.org>"

# ── Super admin (created on first boot) ────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@goldenmilelearning.org
SUPER_ADMIN_INITIAL_PASSWORD=__change_at_first_login__
