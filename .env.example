# GML LMS — environment.
#
# Copy to `.env` beside docker-compose.yml and fill in. `chmod 600 .env`.
#
# This file is RECONCILED against the code: every variable below is actually
# read somewhere, and everything the code reads is listed. The previous version
# drifted badly in both directions — five variables were documented and
# forwarded to no container, five more were read by running code and documented
# nowhere, and it still described Auth.js and MinIO, neither of which exists.
#
# A variable written as `REQUIRED` is enforced by docker-compose: the stack
# refuses to start without it rather than defaulting to something that looks
# like it works.

# ── Host ──────────────────────────────────────────────────────────────────────
# The domain Caddy obtains a certificate for. Must already resolve to this box.
DOMAIN=lms.example.org
# REQUIRED. Let's Encrypt expiry notices go here.
ACME_EMAIL=it@example.org
# Absolute origin used when building links inside emails. Defaults to
# https://$DOMAIN; set it explicitly if the app sits behind another proxy.
APP_URL=https://lms.example.org
NODE_ENV=production
TZ=Asia/Kolkata

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings -> API. All three are REQUIRED.
#
# NEXT_PUBLIC_SUPABASE_URL is the project origin, e.g.
#   https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. Safe in a browser bundle BY DESIGN: on its own it
# grants nothing, because every table has RLS with no policies and the `anon`
# role has been stripped of all privileges (_post/002).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret (service_role) key. NEVER expose this to a browser; it bypasses
# RLS entirely and can create, ban and delete accounts.
SUPABASE_SECRET_KEY=

# Postgres connection string. REQUIRED.
#
# Use the SESSION POOLER (port 5432), NOT the transaction pooler (6543):
# transaction mode disables prepared statements, which Drizzle relies on.
# Copy it from Project Settings -> Database -> Connection string -> Session.
#
#   postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Postgres connections each container may hold open. The session pooler admits
# only as many clients as its pool size (15 by default on the smaller computes;
# Project Settings -> Database -> Connection pooling), and every open
# connection holds one. The defaults -- app 8, worker 4, plus 2 for the deploy's
# one-off scripts and 1 for the worker healthcheck -- add up to exactly 15.
# Raise the pool size in the dashboard first, then these.
# APP_DB_POOL_MAX=8
# WORKER_DB_POOL_MAX=4

# TLS to Postgres is ALWAYS on. Without this variable the connection is
# encrypted but the server certificate is NOT verified, and the app warns about
# it at startup -- because Supavisor presents a certificate issued by
# "Supabase Inc", a private root that is not in Node's trust store.
#
# Download it from Project Settings -> Database -> SSL Configuration and SAVE
# IT AS docker/supabase-ca.crt (replacing the empty placeholder), then
# redeploy. docker-compose.yml mounts that one file into migrate, app and
# worker and points SUPABASE_CA_CERT at it inside each container, so this is
# NOT a variable to set here: a value in this file reaches no container.
# With the CA, the pooler is authenticated as well as encrypted, which is what
# stops an on-path attacker impersonating it. `bash scripts/preflight.sh`
# reports which state you are in.

# ── Email ─────────────────────────────────────────────────────────────────────
# Outbound email is configured in the SUPABASE dashboard
# (Authentication -> Emails -> SMTP Settings), not here. This flag tells the
# application whether a relay is actually attached.
#
# Leave `false` until IT has configured one. While false, magic-link sign-in and
# self-service password reset are hidden, and the UI says plainly that password
# resets go through an administrator — which is true, and better than accepting
# an address and promising a message that cannot be sent.
#
# Flip to `true` and redeploy once SMTP is configured. No code change needed.
AUTH_EMAIL_ENABLED=false

# ── First administrator ───────────────────────────────────────────────────────
# REQUIRED ON THE FIRST DEPLOY (not enforced by compose, because later deploys
# must not need the password): without them no account exists at all, and
# verify-auth fails the deploy saying so.
# Read by the seed only while the database has NO active super_admin, i.e. on
# the first deploy, to create the first usable account. Once one exists they
# are ignored and no account is touched, so demoting or deactivating this one
# in /admin/users sticks across deploys. After the first deploy, change the
# password from /settings and clear SUPER_ADMIN_INITIAL_PASSWORD here.
# Re-running the seed never rotates a live account's password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
# The PRIMARY low-bandwidth video path.
#
# OPTIONAL until the programme switches WhatsApp on. While WHATSAPP_APP_SECRET is
# empty the webhook refuses ALL traffic (503 whatsapp_not_configured) and
# ingest is OFF; everything else, including direct upload, works. deploy.sh and
# preflight.sh say so rather than failing. (It once accepted unsigned POSTs from
# anyone when unset -- the refusal is what replaced that.) Set all four WHATSAPP_*
# values below together, then re-run scripts/deploy.sh.
WHATSAPP_APP_SECRET=
# A random string YOU invent. Meta does not issue it. The GET handshake compares
# hub.verify_token against this value and echoes hub.challenge back on a match --
# it does NOT echo this token, which an earlier version of this comment claimed.
# Must match exactly what you type into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Graph API version for the media fetch. Optional: leave blank to use the version
# pinned in packages/shared/src/whatsapp/graph.ts, which is the normal case.
#
# It exists because the pin went stale without anyone noticing: the code pinned
# v19.0, which Meta expired on 2026-05-21. Meta does not fail a call to an
# expired version -- it serves it from the next-oldest usable one -- so nothing
# broke and nothing recorded the substitution. Setting this lets an operator move
# to a current version without a code deploy.
#
# Must be of the form vNN.N; anything else is ignored with a message on stderr.
# It is shape-checked, not checked against Meta's table: an EXPIRED version such
# as v19.0 is accepted here, and tests/governance/test_173 will not catch it,
# because that test reads the pin from source rather than from this file.
# Current table: https://developers.facebook.com/docs/graph-api/changelog/versions
WHATSAPP_GRAPH_API_VERSION=

# ── Worker ────────────────────────────────────────────────────────────────────
# ONE, not two. A single ffmpeg at -preset veryfast saturates both vCPUs of a
# 2-vCPU instance; a second starves the web tier sharing the box. Queue depth
# absorbs bursts.
WORKER_CONCURRENCY=1

# ── Helpdesk contact details (rendered in the UI) ─────────────────────────────
GML_WHATSAPP_NUMBER=
GML_HELPDESK_PHONE=
GML_HELPDESK_EMAIL=

# ── Section gate passwords (optional, seed-time only) ─────────────────────────
# If set, the seed uses these instead of generating and printing random ones.
# Left commented out (or empty) the seed generates a password per gate and
# prints it ONCE in the deploy output -- write it down then.
# Only read on FIRST seed — an existing gate is never rotated by re-seeding.
# Rotation afterwards is an explicit admin action at /admin/gates.
# GATE_PASSWORD_OBSERVATION=
# GATE_PASSWORD_MENTORSHIP=
# GATE_PASSWORD_ADMIN=

# ── Disaster recovery (scripts/backup.sh) ─────────────────────────────────────
# Where dumps land on this host before being mirrored off it.
BACKUP_ROOT=/var/lib/gml/backups
# An S3 bucket YOU control, for the independent copy. Supabase's own daily
# backups cover Postgres on the Pro plan; Supabase Storage has NO backup
# product at all, so the object mirror below is the only copy of the videos
# that is not Supabase's.
# BACKUP_S3_BUCKET=s3://gml-lms-dr
# AWS_REGION=ap-south-1
# The DR bucket's region when AWS_REGION is not set (default ap-south-1).
# SUPABASE_S3_REGION=ap-south-1
# Days of local dumps backup.sh keeps under BACKUP_ROOT (default 14). Keep it
# equal to "Backup retention" at /admin/system-settings, which says to ask IT
# to set this: the page records the programme's intent, this enforces it.
# KEEP_DAILY=14

# THE VIDEO MIRROR. Without the key, the secret and BACKUP_S3_BUCKET above,
# scripts/backup.sh skips the object mirror -- loudly, on stderr -- and the
# classroom recordings are backed up by nobody.
#
# Project Settings -> Storage -> S3 access keys, under the names that page
# prints ("Access key ID", "Secret access key"). The older short spellings
# SUPABASE_S3_ACCESS_KEY / SUPABASE_S3_SECRET_KEY are also accepted.
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
#
# OPTIONAL. backup.sh derives the endpoint from NEXT_PUBLIC_SUPABASE_URL
# (https://<ref>.storage.supabase.co/storage/v1/s3); set this only when the
# project is served from a custom domain.
# SUPABASE_S3_ENDPOINT=

# ── Seed behaviour (development only) ─────────────────────────────────────────
# Set to `true` to make the seed report what it WOULD do without writing.
# (seed_forms_mentor.ts also accepts the older spelling DRY_RUN=true.)
# SEED_DRY_RUN=false

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Set to 1 to include raw driver error text in /api/health. Off by default:
# those strings carry internal hostnames, ports and auth-failure detail, and
# the endpoint is public.
# HEALTH_DEBUG=0
