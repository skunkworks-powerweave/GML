{
  "name": "@gml/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM schemas + migrations for GML LMS.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./client": "./src/client.ts",
    "./scripts/retention": "./src/scripts/retention.ts",
    "./queue": "./src/queue.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "retention": "tsx src/scripts/retention.ts",
    "seed:all": "tsx src/scripts/seed_all.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.39.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
