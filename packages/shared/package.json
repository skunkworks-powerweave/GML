{
  "name": "@gml/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, TypeScript types, utility helpers across apps/web and apps/worker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api-contracts/*": "./src/api-contracts/*.ts",
    "./auth/*": "./src/auth/*.ts",
    "./storage/*": "./src/storage/*.ts",
    "./sql/*": "./src/sql/*.ts",
    "./whatsapp/*": "./src/whatsapp/*.ts"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "@supabase/supabase-js": "^2.116.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
